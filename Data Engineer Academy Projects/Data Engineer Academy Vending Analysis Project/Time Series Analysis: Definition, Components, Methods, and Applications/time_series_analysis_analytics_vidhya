# Implementation of Auto Regressive Integrated Moving Average (ARIMA) in Python

from statsmodels.tsa.arima_model import ARIMA
model = ARIMA(df_temperature, order=(0, 1, 1)) 
results_ARIMA = model.fit()

results_ARIMA.summary()

# Generate ARIMA forecast
results_ARIMA.forecast(3)[0]

# Output of ARIMA forecast
# array([16.47648941, 16.48621826, 16.49594711])

# Generate ARIMA prediction plot & display plot
results_ARIMA.plot_predict(start=200)
plt.show()

